import os
import sys

# ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================

def ochistit():
    """Очистка экрана"""
    os.system('cls' if os.name == 'nt' else 'clear')

def pauza():
    """Ожидание нажатия Enter"""
    input("\n[Нажмите Enter для продолжения]...")

def zagolovok(text):
    """Вывод заголовка"""
    print("\n" + "=" * 70)
    print(f"  {text}")
    print("=" * 70)

def liniya():
    """Разделительная линия"""
    print("-" * 70)


# ==================== 1. ОБЩАЯ ИНФОРМАЦИЯ О ЗЕМЛЕ ====================

def o_zemle():
    ochistit()
    zagolovok("🌍 ОБЩАЯ ИНФОРМАЦИЯ О ПЛАНЕТЕ ЗЕМЛЯ")
    liniya()

    print("  📌 ОСНОВНЫЕ ПОКАЗАТЕЛИ:")
    liniya()
    print(f"  {'Возраст:':<30}{'4.54 миллиарда лет'}")
    print(f"  {'Расстояние от Солнца:':<30}{'149.6 млн км (1 а.е.)'}")
    print(f"  {'Экваториальный радиус:':<30}{'6,378 км'}")
    print(f"  {'Полярный радиус:':<30}{'6,357 км'}")
    print(f"  {'Площадь:':<30}{'510 млн км²'}")
    print(f"  {'Объём:':<30}{'1,083 млрд км³'}")
    print(f"  {'Масса:':<30}{'5.974 × 10²⁴ кг'}")
    print(f"  {'Средняя плотность:':<30}{'5.52 г/см³'}")
    liniya()

    print("\n  🌡️  ТЕМПЕРАТУРА И АТМОСФЕРА:")
    liniya()
    print(f"  {'Средняя температура:':<30}{'15°C'}")
    print(f"  {'Самая высокая:':<30}{'57.8°C (пустыня Лут)'}")
    print(f"  {'Самая низкая:':<30}{'-89.2°C (Антарктида)'}")
    print(f"  {'Состав атмосферы:':<30}{'78% азот, 21% кислород'}")
    liniya()

    print("\n  🔄 ДВИЖЕНИЕ:")
    liniya()
    print(f"  {'Вокруг своей оси:':<30}{'23 часа 56 минут'}")
    print(f"  {'Вокруг Солнца:':<30}{'365.25 дней'}")
    print(f"  {'Скорость вращения:':<30}{'29.75 км/сек'}")
    print(f"  {'Угол наклона оси:':<30}{'23.4°'}")
    liniya()

    print("\n  🌊 ЗЕМНАЯ КОРА:")
    liniya()
    print(f"  {'Вода (океаны):':<30}{'71%'}")
    print(f"  {'Суша:':<30}{'29%'}")
    print(f"  {'Самая глубокая точка:':<30}{'Марианская впадина (11,034 м)'}")
    print(f"  {'Самая высокая точка:':<30}{'Эверест (8,848 м)'}")
    print(f"  {'Температура ядра:':<30}{'~5,500°C'}")


# ==================== 2. ХРОНОЛОГИЯ ИСТОРИЧЕСКИХ СОБЫТИЙ ====================

def istoricheskie_sobytiya():
    ochistit()
    zagolovok("📜 ВАЖНЫЕ СОБЫТИЯ В ИСТОРИИ ЗЕМЛИ")
    liniya()

    sobytiya = [
        ("4.54 млрд лет назад", "Планета Земля сформировалась из солнечной туманности"),
        ("4.51 млрд лет назад", "Луна появилась из обломков столкновения с планетой Тейя"),
        ("4.4 млрд лет назад", "Начали формироваться первые океаны"),
        ("4.0 млрд лет назад", "Начали формироваться первые континенты"),
        ("3.8 млрд лет назад", "Появились первые признаки жизни (прокариоты)"),
        ("3.5 млрд лет назад", "Строматолиты — древнейшие фотосинтезирующие организмы"),
        ("2.4 млрд лет назад", "Кислородная революция — в атмосфере появился кислород"),
        ("2.0 млрд лет назад", "Появились эукариотические клетки"),
        ("1.2 млрд лет назад", "Появились многоклеточные организмы"),
        ("600 млн лет назад", "Первые сложные животные (эдиакарская фауна)"),
        ("540 млн лет назад", "Кембрийский взрыв — резкое увеличение видов"),
        ("440 млн лет назад", "Ордовикское вымирание — 85% морских видов исчезли"),
        ("365 млн лет назад", "Девонское вымирание — 75% видов исчезли"),
        ("250 млн лет назад", "Пермско-триасовое вымирание — крупнейшее (96% видов)"),
        ("225 млн лет назад", "Появились первые млекопитающие"),
        ("200 млн лет назад", "Началась эпоха господства динозавров"),
        ("66 млн лет назад", "Падение астероида — вымирание динозавров"),
        ("60 млн лет назад", "Началась эпоха развития млекопитающих"),
        ("6-7 млн лет назад", "Появились первые человекообразные"),
        ("2.5 млн лет назад", "Появился род Homo"),
        ("200,000 лет назад", "Появился Homo sapiens (современный человек)"),
        ("12,000 лет назад", "Закончился последний ледниковый период, началось земледелие"),
        ("500 лет назад", "Человек обогнул Землю (экспедиция Магеллана)"),
        ("1961 год", "Юрий Гагарин — первый человек в космосе"),
        ("1969 год", "Нил Армстронг — первый человек на Луне"),
    ]

    print(f"  {'Время':<30}{'Событие'}")
    liniya()
    for vremya, sobytie in sobytiya:
        print(f"  {vremya:<30}{sobytie}")


# ==================== 3. ГЕОЛОГИЧЕСКИЕ ЭРЫ ====================

def geologicheskie_ery():
    ochistit()
    zagolovok("🪨 ГЕОЛОГИЧЕСКИЕ ЭРЫ ЗЕМЛИ")
    liniya()

    ery = [
        ("🔴 ГАДЕЙ", "4.6 - 4.0 млрд лет", "Земля раскалена, нет жизни и атмосферы"),
        ("🟠 АРХЕЙ", "4.0 - 2.5 млрд лет", "Первая жизнь, океаны, бактерии"),
        ("🟡 ПРОТЕРОЗОЙ", "2.5 млрд - 541 млн лет", "Появился кислород, эукариоты"),
        ("🟢 ПАЛЕОЗОЙ", "541 - 252 млн лет", "Рыбы, насекомые, первая жизнь на суше"),
        ("🔵 МЕЗОЗОЙ", "252 - 66 млн лет", "Эра динозавров, появились млекопитающие"),
        ("🟣 КАЙНОЗОЙ", "66 млн лет - сейчас", "Млекопитающие, появился человек"),
    ]

    for era, vremya, opisanie in ery:
        print(f"\n  {era}")
        print(f"     ⏳ {vremya}")
        print(f"     📝 {opisanie}")
        liniya()


# ==================== 4. ВАЖНЫЕ ЯВЛЕНИЯ ДЛЯ ЗЕМЛИ ====================

def vazhnye_yavleniya():
    ochistit()
    zagolovok("⚡ ЯВЛЕНИЯ, НЕОБХОДИМЫЕ ДЛЯ ЖИЗНИ НА ЗЕМЛЕ")
    liniya()

    yavleniya = [
        ("🌊 Круговорот воды", "Испарение, дождь, реки — необходимы для жизни"),
        ("🔄 Движение плит", "Вулканы, землетрясения, формирование континентов"),
        ("🌋 Вулканическая активность", "Формирует атмосферу и земную кору"),
        ("🧲 Магнитное поле", "Защищает от солнечного ветра"),
        ("☀️ Солнечный свет", "Источник фотосинтеза и тепла"),
        ("🌙 Притяжение Луны", "Приливы и стабильность климата"),
        ("⚡ Молния", "Фиксирует азот, необходимый для жизни"),
        ("❄️ Ледниковые периоды", "Изменения климата и эволюция видов"),
        ("☄️ Метеориты", "Принесли воду и органические вещества"),
        ("🌡️ Парниковый эффект", "Поддерживает температуру в норме"),
    ]

    print(f"  {'Явление':<30}{'Описание'}")
    liniya()
    for nazvanie, opisanie in yavleniya:
        print(f"  {nazvanie:<30}{opisanie}")


# ==================== 5. ИНТЕРЕСНЫЕ ФАКТЫ ====================

def interesnye_fakty():
    ochistit()
    zagolovok("💡 ИНТЕРЕСНЫЕ ФАКТЫ О ЗЕМЛЕ")
    liniya()

    fakty = [
        "Земля — 5-я по величине планета Солнечной системы",
        "Земля — единственная известная планета с жидкой водой",
        "71% поверхности Земли покрыто водой",
        "Ядро Земли горячее, чем поверхность Солнца (~5,500°C)",
        "Луна удаляется от Земли на 3.8 см в год",
        "Вращение Земли замедляется — дни становятся длиннее",
        "Без атмосферы температура на Земле была бы -18°C",
        "Магнитное поле Земли защищает жизнь от радиации",
        "Самая древняя порода на поверхности Земли — 4.03 млрд лет",
        "Эверест возвышается на 8,848 м над уровнем моря",
        "Марианская впадина — 11,034 м глубиной",
        "Земля движется со скоростью 29.75 км в секунду",
        "Солнечный свет доходит до Земли за 8 минут 20 секунд",
        "Более 99% поверхности Земли имеет вулканическое происхождение",
        "В истории Земли было 5 массовых вымираний",
        "Более 99% всех видов, когда-либо существовавших, вымерли",
        "Каждый атом в теле человека образовался внутри звёзд",
        "Один оборот Земли вокруг Солнца — 365.25 дней",
        "Земля вращается вокруг своей оси со скоростью 1,670 км/ч",
        "Земля — самая плотная планета Солнечной системы",
    ]

    for i, fakt in enumerate(fakty, 1):
        print(f"  {i:2}. {fakt}")


# ==================== ГЛАВНОЕ МЕНЮ ====================

def main():
    while True:
        ochistit()
        print("\n" + "=" * 70)
        print("  🌍 ПЛАНЕТА ЗЕМЛЯ — ПОЛНОЕ ИНФОРМАЦИОННОЕ ПРИЛОЖЕНИЕ 🌍")
        print("=" * 70)
        print("  1. 🌍 Общая информация о Земле")
        print("  2. 📜 Хронология исторических событий")
        print("  3. 🪨 Геологические эры")
        print("  4. ⚡ Важные явления для Земли")
        print("  5. 💡 Интересные факты")
        print("  0. 🚪 Выход")
        print("-" * 70)

        vybor = input("  Выберите (0-5): ").strip()

        if vybor == '1':
            o_zemle()
            pauza()
        elif vybor == '2':
            istoricheskie_sobytiya()
            pauza()
        elif vybor == '3':
            geologicheskie_ery()
            pauza()
        elif vybor == '4':
            vazhnye_yavleniya()
            pauza()
        elif vybor == '5':
            interesnye_fakty()
            pauza()
        elif vybor == '0':
            ochistit()
            print("\n  🌍 Земля — наш дом! Берегите её!\n")
            sys.exit(0)


if __name__ == "__main__":
    main()
